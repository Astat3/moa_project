      "parameters": {
        "jsCode": "// Même question en français et en anglais : le corpus est en anglais, les requêtes du pipeline le seront aussi.\nreturn [\n  { json: { langue: 'fr', question: 'Quelle est la fiabilité des dispositifs de mesure de pression artérielle sans brassard ?' } },\n  { json: { langue: 'en', question: 'How reliable are cuffless blood pressure measurement devices?' } },\n];"
      }
    },
    {
      "id": "b0000000-0000-4000-8000-000000000002",
      "name": "Qdrant Vector Store",
      "type": "@n8n/n8n-nodes-langchain.vectorStoreQdrant",
      "typeVersion": 1.3,
      "position": [
        440,
        0
      ],
      "parameters": {
        "mode": "load",
        "qdrantCollection": {
          "__rl": true,
          "mode": "id",
          "value": "moa_corpus"
        },
        "prompt": "={{ $json.question }}",
        "topK": 5,
        "includeDocumentMetadata": true,
        "options": {}
      },
