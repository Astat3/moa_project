    },
    {
      "id": "b0000000-0000-4000-8000-000000000004",
      "name": "Affichage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "// Le nœud Qdrant renvoie les résultats des deux questions à la suite : rang recalculé par question.\nconst rangs = {};\nreturn $input.all().map((item, i) => {\n  const { langue } = $('Questions').itemMatching(i).json;\n  rangs[langue] = (rangs[langue] || 0) + 1;\n  const { metadata, pageContent } = item.json.document;\n  return { json: { langue, rang: rangs[langue], score: item.json.score, chunk_id: metadata.chunk_id, doc_id: metadata.doc_id, page: metadata.page, metadata, texte: pageContent } };\n});"
      }
    }
  ],
