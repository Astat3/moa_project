      "name": "Un item par page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1320, 0],
      "parameters": {
        "jsCode": "// Une page = un item, avec les métadonnées du document (meta.json) et le numéro de page.\nconst pages = [];\nfor (const [i, item] of $input.all().entries()) {\n  const meta = $('Un item par document').itemMatching(i).json;\n  item.json.text.forEach((texte, p) => {\n    if (texte.trim()) pages.push({ json: { ...meta, page: p + 1, texte } });\n  });\n}\nreturn pages;"
      }
    },
